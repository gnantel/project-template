#!/usr/bin/env bash
# Formats the file Claude just edited; reads the PostToolUse event from stdin.
set -euo pipefail

edited_file=$(jq -r '.tool_input.file_path // empty')
[ -n "$edited_file" ] && [ -f "$edited_file" ] || exit 0

cd "$CLAUDE_PROJECT_DIR"
case "$edited_file" in
{%- if language == 'python' %}
  *.py|*.pyi) uv run ruff format --quiet "$edited_file" ;;
{%- elif language == 'rust' %}
  *.rs) rustfmt --config skip_children=true "$edited_file" ;;
{%- elif language == 'typescript' %}
  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.jsonc) pnpm exec biome format --write "$edited_file" >/dev/null ;;
{%- endif %}
{%- if language == 'java' %}
  *.java) scripts/format-java.sh "$edited_file" ;;
{%- endif %}
  *) ;;
esac
