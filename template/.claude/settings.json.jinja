{
  "permissions": {
    "allow": [
      "Bash(just:*)",
{%- if language == 'python' %}
      "Bash(uv sync:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run pytest:*)",
{%- elif language == 'rust' %}
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo test:*)",
      "Bash(rustfmt:*)",
{%- elif language == 'typescript' %}
      "Bash(pnpm install:*)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vitest:*)",
{%- elif language == 'java' %}
      "Bash(mvn:*)",
      "Bash(scripts/format-java.sh:*)",
{%- endif %}
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-before-stop.sh"
          }
        ]
      }
    ]
  },
{%- set plugins = [] %}
{%- if spring_boot %}{% set _ = plugins.append('spring-boot@personal') %}{% endif %}
{%- if project_kind == 'service' %}{% set _ = plugins.append('operational-readiness@personal') %}{% endif %}
{%- if plugins %}
  "enabledPlugins": {
{%- for plugin in plugins %}
    "{{ plugin }}": true{{ "," if not loop.last }}
{%- endfor %}
  }
{%- else %}
  "enabledPlugins": {}
{%- endif %}
}
