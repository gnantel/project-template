[tools]
{%- if language == 'python' %}
python = "3.12"
uv = "0.13"

[env]
UV_PYTHON_PREFERENCE = "system"
{%- elif language == 'typescript' %}
node = "24"
pnpm = "12"
{%- elif language == 'rust' %}
rust = { version = "1.99", components = "rustfmt,clippy" }
ast-grep = "0.51"
lefthook = "2"
{%- elif language == 'java' %}
java = "temurin-21"
maven = "3.9"
ast-grep = "0.51"
lefthook = "2"
{%- endif %}
