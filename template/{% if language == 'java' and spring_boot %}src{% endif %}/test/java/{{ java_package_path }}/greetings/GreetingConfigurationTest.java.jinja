package {{ java_package }}.greetings;

import static org.junit.jupiter.api.Assertions.assertEquals;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;

/** Checks that the greetings beans are wired from their default settings. */
@SpringBootTest(classes = GreetingConfiguration.class)
class GreetingConfigurationTest {
    @Autowired
    Greeter greeter;

    @Test
    void greeterUsesTheDefaultSalutation() {
        assertEquals("Hello, Ada!", greeter.greet("Ada"));
    }
}
