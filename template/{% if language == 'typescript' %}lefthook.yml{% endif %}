# Git hooks: fast checks on staged files before commit, typecheck and tests before push.

pre-commit:
  jobs:
    - name: format-and-lint
      glob: "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}"
      run: pnpm exec biome check --write --no-errors-on-unmatched {staged_files}
      stage_fixed: true

pre-push:
  jobs:
    - name: typecheck
      run: pnpm exec tsc --noEmit
    - name: test
      run: pnpm exec vitest run
