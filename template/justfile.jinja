# Entry points shared by every project: fmt, lint (check only), test, check.
# `dev` is defined only by variants that have something to run.

{% if language == 'python' -%}
fmt:
    uv run ruff format
    uv run ruff check --fix

lint:
    uv run ruff format --check
    uv run ruff check
    uv run pyright
    scripts/check-file-length.sh '*.py' '*.pyi'

test:
    uv run pytest
{%- elif language == 'rust' -%}
fmt:
    cargo fmt

lint:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    scripts/check-file-length.sh '*.rs'

test:
    if cargo nextest --version >/dev/null 2>&1; then cargo nextest run && cargo test --doc; else cargo test; fi
{%- elif language == 'typescript' -%}
fmt:
    pnpm exec biome check --write

lint:
    pnpm exec biome check
    pnpm exec tsc --noEmit

test:
    pnpm exec vitest run
{%- elif language == 'java' -%}
fmt:
    mvn -B -q spotless:apply

lint:
    mvn -B -q spotless:check test-compile

test:
    mvn -B -q test
{%- if spring_boot and project_kind != 'library' %}

dev:
    mvn -B spring-boot:run
{%- endif %}
{%- else -%}
{% for recipe in ['fmt', 'lint', 'test'] -%}
{{ recipe }}:
    @echo "The {{ language }} toolchain is not set up in this template yet." >&2; exit 1

{% endfor -%}
{%- endif %}

check: lint test
