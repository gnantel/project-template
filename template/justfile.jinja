# Entry points shared by every project: fmt, fmt-files (format only the given files,
# ignoring other file types; used by the git and Claude hooks), lint (check only), test, check.
# `dev` is defined only by variants that have something to run.

{% if language == 'python' -%}
fmt:
    uv run ruff format
    uv run ruff check --fix

[positional-arguments]
@fmt-files *files:
    count=$#; \
    for file in "$@"; do case "$file" in *.py|*.pyi) set -- "$@" "$file" ;; esac; done; \
    shift "$count"; \
    [ "$#" -eq 0 ] || uv run ruff format --quiet "$@"

lint:
    uv run ruff format --check
    uv run ruff check
    uv run pyright
    scripts/check-file-length.sh '*.py' '*.pyi'

test:
    uv run pytest
{%- elif language == 'rust' -%}
fmt:
    cargo fmt

[positional-arguments]
@fmt-files *files:
    count=$#; \
    for file in "$@"; do case "$file" in *.rs) set -- "$@" "$file" ;; esac; done; \
    shift "$count"; \
    [ "$#" -eq 0 ] || rustfmt --config skip_children=true "$@"

lint:
    ast-grep scan
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    scripts/check-file-length.sh '*.rs'

test:
    if cargo nextest --version >/dev/null 2>&1; then cargo nextest run && cargo test --doc; else cargo test; fi
{%- elif language == 'typescript' -%}
fmt:
    pnpm exec biome check --write

[positional-arguments]
@fmt-files *files:
    count=$#; \
    for file in "$@"; do case "$file" in *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.jsonc) set -- "$@" "$file" ;; esac; done; \
    shift "$count"; \
    [ "$#" -eq 0 ] || pnpm exec biome format --write --no-errors-on-unmatched --log-level=none "$@"

lint:
    pnpm exec biome check
    pnpm exec tsc --noEmit

test:
    pnpm exec vitest run
{%- elif language == 'java' -%}
fmt:
    mvn -B -q spotless:apply

[positional-arguments]
@fmt-files *files:
    count=$#; \
    for file in "$@"; do case "$file" in *.java) set -- "$@" "$file" ;; esac; done; \
    shift "$count"; \
    [ "$#" -eq 0 ] || scripts/format-java.sh "$@"

lint:
    ast-grep scan
    mvn -B -q spotless:check test-compile

test:
    mvn -B -q test

# Unlike the shared `check: lint test`, one Maven run avoids paying Maven's startup twice.
check:
    ast-grep scan
    mvn -B -q spotless:check test
{%- if spring_boot and project_kind != 'library' %}

dev:
    mvn -B spring-boot:run
{%- endif %}
{%- else -%}
{% for recipe in ['fmt', 'lint', 'test'] -%}
{{ recipe }}:
    @echo "The {{ language }} toolchain is not set up in this template yet." >&2; exit 1

{% endfor -%}
{%- endif %}
{%- if language != 'java' %}

check: lint test
{%- endif %}
